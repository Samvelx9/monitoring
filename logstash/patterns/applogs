MATCHALL (.+)?
APPNAME ([^ ]+)?
APPTHREADNAME ([^ ]+)?
APPTRACEWORD ([^ ]+)?
APPCLASSNAME ([^ ]+)?
APPHOSTNAME ([^ ]+)?
APPLOGTIMESTAMP \d{4}-\d{2}-\d{2} \d{2}:\d{2}:\d{2},\d{3}
APPLOGLEVEL (FATAL|ERROR|WARN|INFO|DEBUG|TRACE|ALL)
IGNORENEWLINES (\n\t+|\s+)
APPSOURCEWORD [\w-]+
APPBEATSSOURCE /%{APPSOURCEWORD:app.log.dir}/%{APPSOURCEWORD:app.environment}/%{APPSOURCEWORD:app.service.name}/%{APPSOURCEWORD:app.service.version}/.+
APPLOG %{APPLOGTIMESTAMP:app.logtime} %{APPHOSTNAME:app.hostname} %{APPNAME:app.name} %{APPTRACEWORD:app.traceid} %{APPTRACEWORD:app.spanid}( |%{IGNORENEWLINES:ignore.newlines})%{APPLOGLEVEL:app.loglevel} %{APPTHREADNAME:app.threadname} %{APPCLASSNAME:app.classname} %{MATCHALL:app.logmessage}
