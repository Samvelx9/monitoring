      "description": "Latency percentiles computed over the selected dashboard time range.\n\nEach percentile (P50–P99) represents the distribution of all successful requests (2xx) that occurred within the selected time window (e.g. last 3h), based on histogram bucket counts (increase).\n\nUse this table to understand overall user experience during the selected period, not real-time latency spikes.",
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "custom": {
            "align": "auto",
            "cellOptions": {
              "type": "auto"
            },
            "inspect": false
          },
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": 0
              },
              {
                "color": "red",
                "value": 80
              }
            ]
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "path"
            },
            "properties": [
              {
                "id": "custom.width",
                "value": 400
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "count"
            },
            "properties": [
              {
                "id": "decimals",
                "value": 0
              }
            ]
          },
          {
            "matcher": {
              "id": "byRegexp",
              "options": "P50|P75|P90|P95|P99"
            },
            "properties": [
              {
                "id": "unit",
