###############################################################################
#  Fill in every REQUIRED value, then run:  sudo bash monitoring_setup.sh
#  Always keep the single quotes '...'. Do not use the ' character inside values.
###############################################################################

#######  SERVERS  #######

# IP address of this monitoring server
MONITORING_IP=''                 # REQUIRED  e.g. '10.0.0.50'

# Kubernetes master IP (Prometheus federation on port 30900 + application Elasticsearch)
KUBEMASTER_IP=''                 # REQUIRED  e.g. '10.0.0.10'

# NodePort of the application Elasticsearch service
# (on the kube master: kubectl get svc -A | grep -i elastic  -> number after 9200:)
ELASTICSEARCH_NODEPORT=''        # REQUIRED  e.g. '30920'

# Other VMs to monitor (NOT kube nodes). Format IP:role, separated by spaces.
# Each VM needs node-exporter on port 9100 (see README).
SERVERS=''                       # OPTIONAL  e.g. '10.0.0.21:nfs 10.0.0.22:postgres-master 10.0.0.24:nginx'


#######  PASSWORDS  #######

# Elasticsearch 'elastic' user (also the Kibana login). Letters and numbers only.
# To change it after the first start, see README "Change ELASTIC_PASSWORD".
ELASTIC_PASSWORD=''              # REQUIRED

# Grafana 'administrator' user password
GRAFANA_ADMIN_PASSWORD=''        # REQUIRED

# Password of Grafana's PostgreSQL database. Letters and numbers only.
# To change it after the first start, see README "Change POSTGRES_PASSWORD".
POSTGRES_PASSWORD=''             # REQUIRED


#######  ALERTS  #######

# Microsoft Teams webhook URL that receives alerts
TEAMS_WEBHOOK=''                 # REQUIRED

# Email address that receives alerts
ALERT_EMAIL=''                   # REQUIRED  e.g. 'project-alerting@synisys.com'

# Mail server used by Grafana to send emails
SMTP_HOST=''                     # REQUIRED  e.g. 'email.synisys.com:25'
SMTP_USER=''                     # REQUIRED  e.g. 'grafana@synisys.org'
SMTP_PASSWORD=''                 # REQUIRED
SMTP_FROM_NAME='Grafana'         # OPTIONAL  e.g. 'PROJECT-Grafana'


#######  TUNING (defaults are fine for VM with 16gb RAM)  #######

ELASTIC_VERSION=8.9.1
ELASTIC_MEMORY='4g'              # Elasticsearch heap (about 1/4 of server RAM)
LOGSTASH_MEMORY='1g'             # Logstash heap
PROMETHEUS_RETENTION='720h'      # how long metrics are kept (720h = 30 days)
PROMETHEUS_MEMORY='6gb'          # Prometheus memory limit
